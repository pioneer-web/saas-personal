DJANGO_SECRET_KEY=gere-uma-chave-aleatoria-com-50-ou-mais-caracteres
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_ADMIN_PATH=admin
DJANGO_SESSION_COOKIE_AGE=43200

# Ative somente quando o proxy reverso for confiável
# e o acesso direto ao servidor estiver bloqueado.
SECURITY_TRUST_X_FORWARDED_FOR=0

POSTGRES_DB=saas_personal
POSTGRES_USER=saas_personal
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

SUPERADMIN_EMAIL=admin@exemplo.com
SUPERADMIN_PASSWORD=TroqueEstaSenhaForte123!@
SUPERADMIN_NAME=Administrador

# Use 1 apenas quando quiser trocar a senha do superadmin
# intencionalmente no próximo start.
SUPERADMIN_ROTATE_PASSWORD=0

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
